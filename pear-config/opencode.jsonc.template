{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "opencodex"
  ],
  "provider": {
    "opencodex": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCodex",
      "options": {
        "baseURL": "http://127.0.0.1:10100/v1",
        "apiKey": "opencodex-loopback"
      },
      "models": {
        "gpt-5.4-mini": {
          "name": "gpt-5.4-mini (native OpenAI)"
        },
        "gpt-5.5": {
          "name": "gpt-5.5 (native OpenAI)",
          "limit": {
            "context": 272000,
            "output": 32000
          }
        },
        "gpt-5.6-luna": {
          "name": "gpt-5.6-luna (native OpenAI)",
          "limit": {
            "context": 372000,
            "output": 32000
          }
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol (native OpenAI)",
          "limit": {
            "context": 372000,
            "output": 32000
          }
        },
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731 (Fireworks via OpenCodex)",
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        },
        "glm-5p2": {
          "name": "GLM 5.2 (Fireworks via OpenCodex)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "kimi-k2p7-code": {
          "name": "Kimi K2.7 Code (Fireworks via OpenCodex)",
          "limit": {
            "context": 262144,
            "output": 32000
          }
        }
      }
    }
  },
  "model": "opencodex/gpt-5.6-sol",
  "small_model": "opencodex/gpt-5.4-mini",
  "plugin": [
    "__OMO_PLUGIN_PATH__"
  ],
  "agent": {
    "title": {
      "model": "opencodex/gpt-5.4-mini"
    },
    "build": {
      "disable": false
    },
    "explore": {
      "disable": false
    },
    "general": {
      "disable": false
    },
    "plan": {
      "disable": false
    }
  },
  "lsp": true,
  "permission": "allow"
}
